# Kopieren nach .env und ein eigenes, langes Passwort eintragen
MEMOMOJI_ADMIN_PASSWORD=

# Adresse und Port auf dem Host. 127.0.0.1 = nur für den Reverse Proxy,
# 0.0.0.0 = direkt im Netzwerk erreichbar (z. B. zum Testen im LAN)
MEMOMOJI_BIND=127.0.0.1
MEMOMOJI_PORT=8080

# Öffentliche Adresse des Spiels, so wie man sie teilt, z. B.
# https://example.org/memomoji/ (für die Link-Vorschau in WhatsApp & Co.)
MEMOMOJI_PUBLIC_URL=
